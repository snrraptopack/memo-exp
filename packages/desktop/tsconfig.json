{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "Preserve",
    "moduleResolution": "bundler",
    "jsx": "preserve",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["bun", "node"]
  },
  "include": [
    "src",
    "tests",
    "examples",
    "../compiler/src/jsx-types.ts",
    "../compiler/src/ast/tsrx/tsrx-core.d.ts",
    "../../globals.d.ts"
  ]
}
