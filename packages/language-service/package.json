{
  "name": "@memoized-dom/language-service",
  "version": "0.0.5",
  "description": "TypeScript language-service diagnostics and code fixes for memoized-dom",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=24.11.0"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "main": "./dist/index.cjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.cjs",
      "default": "./dist/index.cjs"
    }
  },
  "scripts": {
    "build": "bun run ./scripts/clean.ts && rolldown -c rolldown.config.ts && tsc -p tsconfig.build.json",
    "test": "vitest run --config vitest.config.ts"
  },
  "dependencies": {
    "@memoized-dom/compiler": "workspace:*"
  },
  "peerDependencies": {
    "typescript": ">=5.7"
  },
  "publishConfig": {
    "access": "public"
}
}
