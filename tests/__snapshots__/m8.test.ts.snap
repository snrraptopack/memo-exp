exports[`R8 — code generation > compiles a ternary to an anchored region with its own entity 1`] = `
"import * as _MD from "@memoized-dom/runtime";

const _WRITES_ = ["./component.tsx#loggedIn"];
const _WRITES_2 = ["./component.tsx#count"];

_MD.installAccessTable(
	{
		readers: {
			"./component.tsx#count": ["App/when0", "App/when0/*"],
			"./component.tsx#loggedIn": ["App/when0", "App/when0/*"]
		}
	},
	"App",
	"./component.tsx"
