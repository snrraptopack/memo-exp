{
  "name": "memoized-dom",
  "type": "module",
  "private": false,
  "engines": {
    "node": ">=24.11.0"
  },
  "workspaces": [
    "packages/*",
    "examples/octopulse"
  ],
  "scripts": {
    "build": "bun run --cwd packages/data build && bun run --cwd packages/runtime build && bun run --cwd packages/router build && bun run --cwd packages/compiler build && bun run --cwd packages/vite build && bun run --cwd packages/language-service build",
    "test:root": "vitest run",
    "test:data": "bun run --cwd packages/data test",
    "test:router": "bun run --cwd packages/router test",
    "test:vite": "bun run --cwd packages/vite test",
    "test:server": "bun run --cwd packages/server test",
    "test:language-service": "bun run --cwd packages/language-service test",
    "test:corpus": "bun run scripts/corpus-e2e.ts",
    "lint": "oxlint .",
    "typecheck": "tsc --noEmit",
    "dev": "bun run build && vitest",
    "example:dev": "vite --config examples/vite.config.ts",
    "example:workspace": "MMD_EXAMPLE=workspace/main.ts vite --config examples/vite.config.ts",
    "example:build": "bun run build && vite build --config examples/vite.config.ts",
    "example:preview": "vite preview --config examples/vite.config.ts",
    "bench": "bun run bench/dom/build.ts && esbuild bench/dom/browser-entry.ts --bundle --outfile=bench/dom/dist/browser-bundle.js --format=iife && bun run bench/dom/run.ts",
    "bench:effects": "bun run bench/effects/run.ts",
    "bench:invalidation": "bun run bench/invalidation/run.ts",
    "bench:linker": "bun run bench/linker/run.ts",
    "bench:router": "bun run --cwd packages/router build && vitest bench --run --no-file-parallelism bench/router",
    "bench:lifecycle": "bun run bench/lifecycle/run.ts",
    "bench:children": "bun run bench/children/run.ts",
    "bench:components": "bun run bench/components/run.ts",
    "bench:local-state": "bun run bench/local-state/run.ts",
    "bench:local-derived": "bun run bench/local-derived/run.ts",
    "bench:jsx": "bun run bench/jsx/run.ts",
    "bench:vite": "bun run --cwd packages/vite bench",
    "bench:size": "bun run bench/package-size/run.ts",
    "bench:frameworks": "cd bench/frameworks && bun run run",
    "bench:application": "cd bench/frameworks && bun run run:application",
    "bench:application:ui": "cd bench/frameworks && bun run ui:application"
  },
  "devDependencies": {
    "@jridgewell/trace-mapping": "^0.3.31",
    "@memoized-dom/compiler": "workspace:*",
    "@memoized-dom/data": "workspace:*",
    "@memoized-dom/router": "workspace:*",
    "@memoized-dom/runtime": "workspace:*",
    "@memoized-dom/vite": "workspace:*",
    "@types/babel__core": "^7.20.5",
    "@types/babel__traverse": "^7.28.0",
    "@types/bun": "latest",
    "@types/node": "^26.0.0",
    "esbuild": "^0.28.1",
    "happy-dom": "^20.11.0",
    "oxlint": "^1.79.0",
    "puppeteer-core": "^25.3.0",
    "rolldown": "^1.2.5",
    "typescript": "^7",
    "vite": "^8.2.2",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "animejs": "^4.5.0",
    "gsap": "^3.15.0"
  }
}
